{
	"format_version": "1.26.40",
	"minecraft:block": {
		"description": {
			"identifier": "brr:window_obligatory",
			"menu_category": {
				"category": "construction"
			},
			"traits": {
				"minecraft:multi_block": {
					"direction": "up",
					"parts": 2,
					"enabled_states": [
						"minecraft:multi_block_part"
					]
				},
				"minecraft:placement_direction": {
					"enabled_states": [
						"minecraft:cardinal_direction"
					],
					"y_rotation_offset": 180
				}
			},
			"states": {
				"brr:broken": [
					false,
					true
				]
			}
		},
		"components": {
			"minecraft:light_dampening": 0,
			"minecraft:material_instances": {
				"up": {
					"texture": "brr_nothing",
					"render_method": "alpha_test"
				},
				"down": {
					"texture": "brr_nothing",
					"render_method": "alpha_test"
				},
				"east": {
					"texture": "brr_nothing",
					"render_method": "alpha_test"
				},
				"west": {
					"texture": "brr_nothing",
					"render_method": "alpha_test"
				},
				"north": {
					"texture": "brr_window_obligatory",
					"render_method": "alpha_test"
				},
				"south": {
					"texture": "brr_window_3",
					"render_method": "alpha_test"
				}
			},
			"minecraft:geometry": {
				"identifier": "geometry.brr_window",
				"culling": "brr:cull_tool"
			},
			"brr:window_interact": {},
			"minecraft:movable": {
				"movement_type": "immovable",
				"sticky": "none"
			}
		},
		"permutations": [
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'north'",
				"components": {
					"minecraft:transformation": {
						"rotation": [
							0,
							0,
							0
						]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'south'",
				"components": {
					"minecraft:transformation": {
						"rotation": [
							0,
							180,
							0
						]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'west'",
				"components": {
					"minecraft:transformation": {
						"rotation": [
							0,
							90,
							0
						]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'east'",
				"components": {
					"minecraft:transformation": {
						"rotation": [
							0,
							-90,
							0
						]
					}
				}
			},
			{
				"condition": "q.block_state('minecraft:multi_block_part') == 1",
				"components": {
					"minecraft:material_instances": {
						"up": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"down": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"east": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"west": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"north": {
							"texture": "brr_window_1",
							"render_method": "alpha_test"
						},
						"south": {
							"texture": "brr_window_2",
							"render_method": "alpha_test"
						}
					}
				}
			},
			{
				"condition": "q.block_state('minecraft:multi_block_part') == 0 && q.block_state('brr:broken')",
				"components": {
					"minecraft:material_instances": {
						"up": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"down": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"east": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"west": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"north": {
							"texture": "brr_window_broke_0",
							"render_method": "alpha_test"
						},
						"south": {
							"texture": "brr_window_broke_3",
							"render_method": "alpha_test"
						}
					},
					"minecraft:collision_box": false
				}
			},
			{
				"condition": "q.block_state('minecraft:multi_block_part') == 1 && q.block_state('brr:broken')",
				"components": {
					"minecraft:material_instances": {
						"up": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"down": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"east": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"west": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"north": {
							"texture": "brr_window_broke_1",
							"render_method": "alpha_test"
						},
						"south": {
							"texture": "brr_window_broke_2",
							"render_method": "alpha_test"
						}
					},
					"minecraft:collision_box": false
				}
			}
		]
	}
}
