{
	"format_version": "1.26.40",
	"minecraft:block": {
		"description": {
			"identifier": "brr:door_bedroom",
			"menu_category": {
				"category": "construction"
			},
			"traits": {
				"minecraft:multi_block": {
					"direction": "up",
					"parts": 2,
					"enabled_states": [
						"minecraft:multi_block_part"
					]
				},
				"minecraft:placement_direction": {
					"enabled_states": [
						"minecraft:cardinal_direction"
					],
					"y_rotation_offset": 180
				}
			},
			"states": {
				"brr:open": [
					false,
					true
				],
				"brr:barred": [
					false,
					true
				]
			}
		},
		"components": {
			"minecraft:light_dampening": 15,
			"minecraft:material_instances": {
				"up": {
					"texture": "brr_nothing",
					"render_method": "alpha_test"
				},
				"down": {
					"texture": "brr_nothing",
					"render_method": "alpha_test"
				},
				"east": {
					"texture": "brr_nothing",
					"render_method": "alpha_test"
				},
				"west": {
					"texture": "brr_nothing",
					"render_method": "alpha_test"
				},
				"*": {
					"texture": "brr_door_bedroom_closed_bottom",
					"render_method": "alpha_test"
				}
			},
			"minecraft:geometry": {
				"identifier": "geometry.brr_door_split_bottom",
				"culling": "brr:cull_tool"
			},
			"minecraft:movable": {
				"movement_type": "immovable",
				"sticky": "none"
			},
			"brr:door_interact": {}
		},
		"permutations": [
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'north'",
				"components": {
					"minecraft:transformation": {
						"rotation": [
							0,
							0,
							0
						]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'south'",
				"components": {
					"minecraft:transformation": {
						"rotation": [
							0,
							180,
							0
						]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'west'",
				"components": {
					"minecraft:transformation": {
						"rotation": [
							0,
							90,
							0
						]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'east'",
				"components": {
					"minecraft:transformation": {
						"rotation": [
							0,
							-90,
							0
						]
					}
				}
			},
			{
				"condition": "q.block_state('minecraft:multi_block_part') == 1",
				"components": {
					"minecraft:material_instances": {
						"up": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"down": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"east": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"west": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"*": {
							"texture": "brr_door_bedroom_closed_top",
							"render_method": "alpha_test"
						}
					},
					"minecraft:geometry": {
						"identifier": "geometry.brr_door_split_top",
						"culling": "brr:cull_tool"
					}
				}
			},
			{
				"condition": "q.block_state('minecraft:multi_block_part') == 0 && q.block_state('brr:open')",
				"components": {
					"minecraft:material_instances": {
						"up": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"down": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"east": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"west": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"*": {
							"texture": "brr_door_bedroom_open_bottom",
							"render_method": "alpha_test"
						}
					},
					"minecraft:geometry": {
						"identifier": "geometry.brr_door_split_bottom",
						"culling": "brr:cull_tool"
					},
					"minecraft:light_dampening": 0,
					"minecraft:collision_box": false,
					"minecraft:selection_box": false
				}
			},
			{
				"condition": "q.block_state('minecraft:multi_block_part') == 1 && q.block_state('brr:open')",
				"components": {
					"minecraft:material_instances": {
						"up": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"down": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"east": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"west": {
							"texture": "brr_nothing",
							"render_method": "alpha_test"
						},
						"*": {
							"texture": "brr_door_bedroom_open_top",
							"render_method": "alpha_test"
						}
					},
					"minecraft:geometry": {
						"identifier": "geometry.brr_door_split_top",
						"culling": "brr:cull_tool"
					},
					"minecraft:light_dampening": 0,
					"minecraft:collision_box": false,
					"minecraft:selection_box": false
				}
			}
		]
	}
}
