{
	"format_version": "1.21.80",
	"minecraft:entity": {
		"description": {
			"identifier": "brr:scientist_01",
			"is_spawnable": true,
			"is_summonable": true,
			"is_experimental": false,
			"properties": {
				"brr:react": {
					"type": "int",
					"range": [
						0,
						7
					],
					"default": 0,
					"client_sync": true
				},
				"brr:react_n": {
					"type": "int",
					"range": [
						0,
						15
					],
					"default": 0,
					"client_sync": true
				},
				"brr:provoked": {
					"type": "bool",
					"default": false,
					"client_sync": true
				}
			}
		},
		"component_groups": {
			"brr:provoked": {
				"minecraft:behavior.avoid_mob_type": {
					"priority": 2,
					"entity_types": [
						{
							"filters": {
								"test": "is_family",
								"subject": "other",
								"value": "player"
							},
							"max_dist": 7,
							"walk_speed_multiplier": 1,
							"sprint_speed_multiplier": 1.15
						}
					],
					"remove_target": false
				}
			},
			"brr:idle_ai": {
				"minecraft:behavior.random_stroll": {
					"priority": 4,
					"speed_multiplier": 1.1,
					"xz_dist": 10,
					"y_dist": 2
				},
				"minecraft:behavior.look_at_player": {
					"priority": 11
				}
			},
			"brr:talking": {
				"minecraft:behavior.look_at_entity": {
					"priority": 1,
					"look_distance": 6,
					"probability": 1,
					"look_time": [
						30,
						30
					],
					"angle_of_view_horizontal": 360,
					"filters": {
						"test": "is_family",
						"subject": "other",
						"value": "scientist"
					}
				}
			}
		},
		"components": {
			"minecraft:collision_box": {
				"width": 0.8,
				"height": 2.2
			},
			"minecraft:navigation.walk": {
				"can_walk": true,
				"can_swim": true,
				"can_pass_doors": true,
				"avoid_portals": true,
				"avoid_damage_blocks": true
			},
			"minecraft:health": {
				"value": 25,
				"max": 25
			},
			"minecraft:movement": {
				"value": 0.2
			},
			"minecraft:movement.basic": {},
			"minecraft:nameable": {
				"allow_name_tag_renaming": true,
				"always_show": false
			},
			"minecraft:walk_animation_speed": {
				"value": 1
			},
			"minecraft:knockback_resistance": {
				"value": 255
			},
			"minecraft:physics": {},
			"minecraft:pushable_by_entity": {},
			"minecraft:pushable_by_block": {},
			"minecraft:type_family": {
				"family": [
					"scientist",
					"npc",
					"mob"
				]
			}
		},
		"events": {
			"minecraft:entity_spawned": {
				"add": {
					"component_groups": [
						"brr:idle_ai"
					]
				}
			},
			"brr:become_provoked": {
				"add": {
					"component_groups": [
						"brr:provoked"
					]
				},
				"set_property": {
					"brr:provoked": true
				}
			},
			"brr:calm_down": {
				"remove": {
					"component_groups": [
						"brr:provoked"
					]
				},
				"set_property": {
					"brr:provoked": false
				}
			},
			"brr:start_talking": {
				"remove": {
					"component_groups": [
						"brr:idle_ai"
					]
				},
				"add": {
					"component_groups": [
						"brr:talking"
					]
				}
			},
			"brr:stop_talking": {
				"remove": {
					"component_groups": [
						"brr:talking"
					]
				},
				"add": {
					"component_groups": [
						"brr:idle_ai"
					]
				}
			}
		}
	}
}