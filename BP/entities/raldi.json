{
	"format_version": "1.21.130",
	"minecraft:entity": {
		"description": {
			"identifier": "brr:raldi",
			"is_spawnable": true,
			"is_summonable": true,
			"is_experimental": false,
			"properties": {
				"brr:visual": {
					"type": "int",
					"range": [0, 7],
					"default": 2,
					"client_sync": true
				},
				"brr:frame": {
					"type": "int",
					"range": [0, 186],
					"default": 0,
					"client_sync": true
				}
			}
		},
		"component_groups": {},
