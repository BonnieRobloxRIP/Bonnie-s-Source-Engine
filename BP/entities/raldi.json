			},
			"brr:move": {
				"set_property": { "brr:visual": 4, "brr:frame": 0 }
			},
			"brr:crackpipe": {
				"set_property": { "brr:visual": 5, "brr:frame": 0 }
			},
			"brr:drip": {
				"set_property": { "brr:visual": 6, "brr:frame": 0 }
			}
