{
	"format_version": "1.8.0",
	"animations": {
		"animation.brr.crafters.billboard": {
			"loop": true,
			"bones": {
				"sprite": {
					"rotation": [0, "-q.body_y_rotation + q.camera_rotation(1)", 0]
				}
			}
		},
		"animation.brr.crafters.hidden": {
			"loop": true,
			"bones": {
				"sprite": {
					"scale": [0, 0, 0]
				}
			}
		}
	}
}
