{
  "namespace": "tool_trigger",
  "$schema": "https://kalmemarq.github.io/Bugrock-JSON-UI-Schemas/ui.schema.json",

  "custom_form": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        //------------Main Panel---------------//
        "default_custom_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": ["100% - 15px", 10],
          "$title_max_size": ["100% - 15px", 10],
          "size": [225, 200],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.custom_form_panel",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not (#title_text = 'Trigger Tool'))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        //------------Custom Form---------------//
        "create_form": {
          "type": "panel",
          "offset": [0, 10],
          "size": [360, 360],
          "layer": 2,
          "controls": [
            { "custom_form_bg@server_form.custom_form_bg": {} },
            { "category_selection_pannel@server_form.category_selection_pannel": {} },
            { "category_content_panel@server_form.category_content_panel": {} },
            {
              "submit_button@server_form.submit_button": {
                "layer": 999
              }
            },
            { "close_button@server_form.close_button": {} }
          ],
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = 'Trigger Tool')",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  "custom_form_bg_anim_start": {
    "anim_type": "alpha",
    "from": 0,
    "to": 1,
    "duration": 0.5,
    "easing": "linear"
  },
  "custom_form_bg": {
    "type": "image",
    "layer": 0,
    "size": "@server_form.custom_form_bg_anim_start",
    "texture": "textures/assets/reference"
  },

  "category_selection_pannel": {
    "type": "panel",
    "size": [200, 20],
    "offset": ["66%", 46],
    "anchor_from": "top_left",
    "anchor_to": "top_right",
    "controls": [
      {
        "toogle_none_selected": {
          "type": "stack_panel",
          "size": ["100%", "100%"],
          "layer": 1,
          "orientation": "horizontal",
          // prettier-ignore
          "controls": [
            { "select_catagory_toggle@server_form.select_catagory_toggle": { "$name": "toggleHome", "$text": "Class", "$index": 10, "$toggle_size": [75, 20], "$padding": [75, 20] } },
            { "select_catagory_toggle@server_form.select_catagory_toggle": { "$name": "toggleInteract", "$text": "Output", "$index": 11, "$toggle_size": [75, 20], "$padding": [75, 20] } },
            { "select_catagory_toggle@server_form.select_catagory_toggle": { "$name": "toggleHit", "$text": "Input", "$index": 12, "$toggle_size": [75, 20], "$padding": [75, 20] } }
          ]
        }
      }
    ]
  },

  "category_content_panel": {
    "type": "panel",
    "size": ["48%", "100%"],
    "layer": 6,
    "offset": ["-10.5%", "21%"],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "class_screen": {
          "type": "stack_panel",
          "size": ["100%", "100%"],
          "orientation": "vertical",
          "collection_name": "custom_form",
          "controls": [
            {
              "option_text_edit@server_form.option_text_edit": {
                "collection_index": 3
              }
            },
            { "slider_text": { "type": "label", "text": "" } },
            {
              "option_text_edit@server_form.option_text_edit": {
                "collection_index": 6
              }
            },
            { "slider_text": { "type": "label", "text": "" } },
            {
              "option_text_edit@server_form.option_text_edit": {
                "collection_index": 7
              }
            },
            { "slider_text": { "type": "label", "text": "" } },
            {
              "option_text_edit@server_form.option_text_edit": {
                "collection_index": 8
              }
            },
            { "slider_text": { "type": "label", "text": "" } },
            {
              "option_text_edit@server_form.option_text_edit": {
                "collection_index": 9
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "toggleHome",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "class_screen2": {
          "type": "stack_panel",
          "size": ["77%", "100%"],
          "offset":["79.2%", "-3% + 3px"],
          "orientation": "vertical",
          "collection_name": "custom_form",
          "controls": [
            { "slider_text": { "type": "label", "text": "" } },
            { "option_dropdown@server_form.option_dropdown": { "collection_index": 5} }

          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "toggleHome",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "class_screen3": {
          "type": "stack_panel",
          "size": ["77%", "100%"],
          "offset":["79.2%", "50%"],
          "orientation": "vertical",
          "collection_name": "custom_form",
          "controls": [
            { "toggle_1@server_form.option_toggle": { "collection_index": 4 } }

          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "toggleHome",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "output_screen": {
          "type": "stack_panel",
          "size": ["100%", "100%"],
          "orientation": "vertical",
          "collection_name": "custom_form",
          "controls": [
            {
              "option_text_edit@server_form.option_text_edit": {
                "collection_index": 14
              }
            },
            { "slider_text": { "type": "label", "text": "" } },
            {
              "option_text_edit@server_form.option_text_edit": {
                "collection_index": 18
              }
            },
            { "slider_text": { "type": "label", "text": "" } },
            {
              "option_text_edit@server_form.option_text_edit": {
                "collection_index": 19
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "toggleInteract",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "output_screen2": {
          "type": "stack_panel",
          "size": ["77%", "100%"],
          "offset":["79.2%", "-3% + 3px"],
          "orientation": "vertical",
          "collection_name": "custom_form",
          "controls": [
            { "slider_text": { "type": "label", "text": "" } },
            { "option_dropdown@server_form.option_dropdown": { "collection_index": 15} },
            { "slider_text": { "type": "label", "text": "" } },
            { "option_dropdown@server_form.option_dropdown": { "collection_index": 16} },
            { "slider_text": { "type": "label", "text": "" } },
            { "option_dropdown@server_form.option_dropdown": { "collection_index": 17} }

          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "toggleInteract",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "output_screen3": {
          "type": "stack_panel",
          "size": ["77%", "100%"],
          "offset":["79.2%", "50%"],
          "orientation": "vertical",
          "collection_name": "custom_form",
          "controls": [
            { "toggle_1@server_form.option_toggle": { "collection_index": 13 } }

          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "toggleInteract",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "input_screen": {
          "type": "stack_panel",
          "size": ["100%", "100%"],
          "orientation": "vertical",
          "collection_name": "custom_form",
          "controls": [
            {"text_data@server_form.custom_label": { "collection_index": 21 }},
            {"text_data@server_form.custom_label": { "collection_index": 23 }},
            {"text_data@server_form.custom_label": { "collection_index": 24 }},
            {"text_data@server_form.custom_label": { "collection_index": 28 }}

          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "toggleHit",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "input_screen2": {
          "type": "stack_panel",
          "size": ["77%", "100%"],
          "offset":["79.2%", "-3% + 3px"],
          "orientation": "vertical",
          "collection_name": "custom_form",
          "controls": [
            { "slider_text": { "type": "label", "text": "" } },
            {"text_data@server_form.custom_label": { "collection_index": 25 }},
            {"text_data@server_form.custom_label": { "collection_index": 26 }},
            {"text_data@server_form.custom_label": { "collection_index": 27 }}

          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "toggleHit",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "input_screen3": {
          "type": "stack_panel",
          "size": ["77%", "100%"],
          "offset":["79.2%", "50%"],
          "orientation": "vertical",
          "collection_name": "custom_form",
          "controls": [
            { "toggle_1@server_form.option_toggle": { "collection_index": 29 } }

          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "toggleHit",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  //------------Toggles---------------//
  "toggle_button_appear_animation": {
    "anim_type": "alpha",
    "from": 0,
    "to": 1,
    "duration": 1.5,
    "easing": "linear"
  },

  "select_catagory_toggle": {
    "type": "panel",
    "layer": 99,
    "$toggle_size|default": [170, 30],
    "$padding|default": [170, 40],
    "$index|default": 1,
    "$name|default": "view_toggle",
    "$text|default": "Toggle",
    "size": "$padding",
    "controls": [
      {
        "custom_toggle@common_toggles.light_text_toggle": {
          "$default_texture": "textures/ui/recipe_book_item_bg",
          "$default_size": [170, 40],
          "$hover_size": [270, 140],

          "$hover_checked_text_color": [1, 1, 1],
          "$default_checked_text_color": [1, 1, 1],
          "$hover_text_color": [1, 1, 1],
          "$default_text_color": [1, 1, 1],

          "$default_border_visible": false,
          "$hover_border_visible": false,

          "$toggle_name": "our_toggle",
          "$button_text": "$text",
          "size": "$toggle_size",
          "$toggle_view_binding_name": "$name",
          "$radio_toggle_group": true,
          "$toggle_group_default_selected": 1,
          "$toggle_group_forced_index": "$index",
          "anchor_from": "center",
          "anchor_to": "center",

          "$font_type": "MinecraftTen",
          "$new_ui_label_offset": [0, -2]
        }
      }
    ]
  },

  //Content
  "close_button_appear_animation": {
    "anim_type": "alpha",
    "from": 0,
    "to": 1,
    "duration": 1.5,
    "easing": "linear"
  },
  "close_button": {
    "type": "button",
    "layer": 9999,
    "offset": ["-8% - 2px", "12% + 1.5px"],
    "default_control": "default",
    "hover_control": "hover",
    "$default_texture|default": "textures/ui/exit_button",
    "$hover_texture|default": "textures/ui/exit_button_hover",
    "$alpha|default": "@server_form.close_button_appear_animation",
    "$size|default": [25, 25],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [20, 20],
    "sound_name": "random.click",
    "controls": [
      {
        "default": {
          "type": "image",
          "size": "$size",
          "alpha": "$alpha",
          "texture": "$default_texture"
        }
      },
      {
        "hover": {
          "type": "image",
          "size": "$size",
          "texture": "$hover_texture",
          "alpha": "$alpha"
        }
      }
    ],
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_exit",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.menu_exit",
        "mapping_type": "focused"
      }
    ]
  },

  "submit_button_appear_animation": {
    "anim_type": "alpha",
    "from": 0,
    "to": 1,
    "duration": 1.5,
    "easing": "linear"
  },
  "submit_button@common_buttons.light_text_button": {
    "$default_button_texture": "textures/ui/recipe_book_item_bg",
    "$hover_button_texture": "textures/ui/recipe_book_item_bg",
    "$pressed_button_texture": "textures/ui/recipe_book_item_bg",

    "$default_border_visible": false,
    "$hover_border_visible": false,

    "$pressed_button_name": "button.submit_custom_form",
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "size": [112, 25],
    "$default_button_alpha": "@server_form.submit_button_appear_animation",
    "offset": [-41, -62],
    "$new_ui_label_offset": [0, -2],
    "$hover_text_color": [0, 1, 0.2],
    "$font_type": "MinecraftTen",
    "$button_text": "Submit"
  },
  "option_slider@settings_common.option_slider": {
    "size": ["100% - 32px", 28],
    "$custom_option_label": "#custom_slider_text",
    "$slider_name": "custom_slider",
    "$slider_value_binding_name": "#custom_slider_value",
    "$slider_tts_text_value": "#custom_slider_text_value",
    "$slider_binding_type": "collection",
    "$slider_collection_name": "custom_form",
    "$slider_enabled_binding_name": "#custom_slider_enabled",
    "$slider_enabled_binding_type": "collection",
    "$label_bindings": [
      {
        "binding_name": "#custom_slider_text",
        "binding_type": "collection",
        "binding_collection_name": "custom_form"
      }
    ]
  },
  "custom_label@settings_common.option_group_label": {
    "$text": "#custom_text",
    "$text_bindings": [
      {
        "binding_name": "#custom_text",
        "binding_type": "collection",
        "binding_collection_name": "custom_form"
      }
    ]
  },
  "option_dropdown@settings_common.option_dropdown": {
    "size": ["100% - 32px", 22],
    "collection_index": "$index",
    "$custom_option_label": "",
    "$options_dropdown_toggle_label_font_type": "MinecraftTen",
    "$options_dropdown_toggle_label_font_scale": 0.8,
    "$radio_label_font_type": "pixel",
    "$radio_label_font_scale": 0.8,
    "$content_label_offset": [16, 1],
    "$dropdown_content": "server_form.custom_dropdown_content",
    "$dropdown_area": "generated_form",
    "$dropdown_name": "custom_dropdown",
    "$toggle_binding_type": "collection",
    "$toggle_grid_collection_name": "custom_form",
    "$options_dropdown_toggle_label_binding": "#dropdown_option_text",
    "$options_dropdown_toggle_label_binding_type": "collection",
    "$options_dropdown_toggle_label_binding_collection_name": "custom_form",
    "$dropdown_scroll_content_size": ["100%", "500%"]
  },

  "option_toggle@settings_common.option_toggle": {
    "$custom_option_label": "#custom_text",
    "$toggle_name": "custom_toggle",
    "$toggle_state_binding_name": "#custom_toggle_state",
    "$option_binding_name": "#custom_toggle_state",
    "$toggle_binding_type": "collection",
    "$toggle_enabled_binding_name": "#custom_toggle_enabled",
    "$toggle_enabled_binding_type": "collection",
    "$toggle_grid_collection_name": "custom_form",
    "$label_bindings": [
      {
        "binding_name": "#custom_text",
        "binding_type": "collection",
        "binding_collection_name": "custom_form"
      }
    ]
  },
  "option_text_edit@settings_common.option_text_edit": {
    "$custom_option_label": "#custom_text",
    "$indent_texture": "textures/ui/submit_button_bg",
    "$indent_hover_texture": "textures/ui/submit_button_bg_hover",

    "size": ["100% - 32px", 28],
    "$option_place_holder_text": "#custom_placeholder_text",
    "$text_edit_box_placeholder_content_binding_name": "$option_place_holder_text",
    "$text_edit_box_placeholder_content_binding_type": "collection",
    "$text_edit_box_grid_collection_name": "custom_form",
    "$max_text_edit_length": 100,
    "$text_edit_box_content_binding_type": "collection",
    "$text_edit_box_content_binding_name": "#custom_input_text",
    "$option_binding_name": "#custom_input_text",
    "$text_box_enabled_binding_name": "#custom_input_enabled",
    "$text_box_name": "custom_input",
    "$option_tooltip_binding_type": "collection",
    "$option_tooltip_collection_name": "custom_form",
    "$option_tooltip_text_binding_name": "#custom_tooltip_text",
    "$option_tooltip_area": "inside_header_panel",
    "$option_tooltip_visible": true,
    "$label_bindings": [
      {
        "binding_name": "#custom_text",
        "binding_type": "collection",
        "binding_collection_name": "custom_form"
      }
    ]
  }
}