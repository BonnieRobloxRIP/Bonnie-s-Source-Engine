{
  "namespace": "tool_npcclip",
  "$schema": "https://kalmemarq.github.io/Bugrock-JSON-UI-Schemas/ui.schema.json",

  "category_selection_pannel": {
    "type": "panel",
    "size": [150, 20],
    "offset": ["66%", 46],
    "anchor_from": "top_left",
    "anchor_to": "top_right",
    "controls": [
      {
        "toogle_none_selected": {
          "type": "stack_panel",
          "size": ["100%", "100%"],
          "layer": 1,
          "orientation": "horizontal",
          "controls": [
            { "select_catagory_toggle@server_form.select_catagory_toggle": { "$name": "toggleNpcHome", "$text": "Class", "$index": 10, "$toggle_size": [75, 20], "$padding": [75, 20] } },
            { "select_catagory_toggle@server_form.select_catagory_toggle": { "$name": "toggleNpcInteract", "$text": "Inputs", "$index": 11, "$toggle_size": [75, 20], "$padding": [75, 20] } }
          ]
        }
      }
    ]
  },

  "category_content_panel": {
    "type": "panel",
    "size": ["48%", "100%"],
    "layer": 6,
    "offset": ["-10.5%", "21%"],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "class_screen": {
          "type": "stack_panel",
          "size": ["100%", "100%"],
          "orientation": "vertical",
          "collection_name": "custom_form",
          "controls": [
            { "option_text_edit@server_form.option_text_edit": { "collection_index": 3 } },
            { "slider_text": { "type": "label", "text": "" } },
            { "option_text_edit2@server_form.option_text_edit": { "collection_index": 5 } }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "toggleNpcHome",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "class_screen3": {
          "type": "stack_panel",
          "size": ["77%", "100%"],
          "offset": ["79.2%", "50%"],
          "orientation": "vertical",
          "collection_name": "custom_form",
          "controls": [
            { "toggle_1@server_form.option_toggle": { "collection_index": 4 } }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "toggleNpcHome",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "inputs_screen": {
          "type": "stack_panel",
          "size": ["100%", "100%"],
          "orientation": "vertical",
          "collection_name": "custom_form",
          "controls": [
            { "text_data@server_form.custom_label": { "collection_index": 7 } },
            { "slider_text": { "type": "label", "text": "" } },
            { "text_data2@server_form.custom_label": { "collection_index": 9 } }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "toggleNpcInteract",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  }
}
