{
	"namespace": "server_form",

	// Every form pops in and out instantly: the screen keeps only zero-length exit animations, so vanilla's
	// slide/fade entrance never plays. Same override as Bonnie's Source Engine, so this pack doesn't depend on it.
	"brr_no_anim_exit_push": {
		"anim_type": "offset", "duration": 0, "from": [ 0, 0 ], "to": [ 0, 0 ],
		"play_event": "screen.exit_push", "end_event": "screen.exit_end"
	},
	"brr_no_anim_exit_pop": {
		"anim_type": "offset", "duration": 0, "from": [ 0, 0 ], "to": [ 0, 0 ],
		"play_event": "screen.exit_pop", "end_event": "screen.exit_end"
	},
	"third_party_server_screen@common.base_screen": {
		"$screen_content": "server_form.main_screen_content",
		"$screen_animations": [ "@server_form.brr_no_anim_exit_push", "@server_form.brr_no_anim_exit_pop" ],
		"$background_animations": [],
		"$use_loading_bars": false,
		"button_mappings": [
			{ "from_button_id": "button.menu_cancel", "to_button_id": "button.menu_exit", "mapping_type": "global" }
		]
	},

	// Reserve these title markers for custom forms; use the same string-subtraction rule as the meme UI.
	"long_form": {
		"modifications": [
			{
				"array_name": "bindings",
				"operation": "insert_back",
				"value": [
					{ "binding_name": "#title_text" },
					{
						"binding_type": "view",
						"source_property_name": "(((((((#title_text - 'brr:meme') - 'brr:gameboy') - 'brr:phone') - 'brr:menu') - 'brr:battle') - 'brr:nb:') = #title_text)",
						"target_property_name": "#visible"
					}
				]
			}
		]
	},

	// The hidden vanilla form still built a full button (~25 controls) for every brr form button, which made
	// each battle page slow to open. The button factory now only fills in once it is visible, like vanilla's
	// storage_management content panel, so brr forms never build those buttons.
	"long_form_dynamic_buttons_panel": {
		"visible": false,
		"modifications": [
			{
				"array_name": "bindings",
				"operation": "remove",
				"where": { "binding_name": "#form_button_contents", "binding_name_override": "#collection_length" }
			},
			{
				"array_name": "bindings",
				"operation": "insert_back",
				"value": [
					{ "binding_name": "#title_text" },
					{
						"binding_type": "view",
						"source_property_name": "(((((((#title_text - 'brr:meme') - 'brr:gameboy') - 'brr:phone') - 'brr:menu') - 'brr:battle') - 'brr:nb:') = #title_text)",
						"target_property_name": "#visible"
					},
					{ "binding_name": "#form_button_contents", "binding_name_override": "#collection_length", "binding_condition": "visible" }
				]
			}
		]
	},

	// Hidden controls are still built, so the menu (like each battle page, see brr_battle.json) only fills
	// its one-cell grid while a menu form is up; other brr forms never build it.
	"brr_menu_lazy": {
		"type": "panel",
		"size": [ "100%", "100%" ],
		"bindings": [
			{ "binding_name": "#title_text" },
			{ "binding_type": "view", "source_property_name": "(not ((#title_text - 'brr:menu:') = #title_text))", "target_property_name": "#visible" }
		],
		"controls": [
			{
				"grid": {
					"type": "grid",
					"size": [ "100%", "100%" ],
					"grid_dimensions": [ 1, 1 ],
					"maximum_grid_items": 0,
					"grid_item_template": "brr_menu.root",
					"collection_name": "form_buttons",
					"bindings": [
						{ "binding_name": "#form_button_contents", "binding_name_override": "#maximum_grid_items", "binding_condition": "visible" }
					]
				}
			}
		]
	},

	"main_screen_content": {
		"size": [ "100%", "100%" ],
		"modifications": [
			{
				"array_name": "controls",
				"operation": "insert_back",
				"value": [
					{
						"brr_battle_factory": {
							"type": "panel",
							"factory": {
								"name": "server_form_factory",
								"control_ids": { "long_form": "@brr_battle.form" }
							}
						}
					},
					{
						"brr_notebook_factory": {
							"type": "panel",
							"factory": {
								"name": "server_form_factory",
								"control_ids": { "long_form": "@brr_notebook.form" }
							}
						}
					},
					{
						"brr_menu_factory": {
							"type": "panel",
							"factory": {
								"name": "server_form_factory",
								"control_ids": { "long_form": "@server_form.brr_menu_lazy" }
							}
						}
					},
					{
						"brr_gameboy_factory": {
							"type": "panel",
							"factory": {
								"name": "server_form_factory",
								"control_ids": { "long_form": "@server_form.brr_gameboy_form" }
							}
						}
					},
					{
						"brr_phone_factory": {
							"type": "panel",
							"factory": {
								"name": "server_form_factory",
								"control_ids": { "long_form": "@server_form.brr_phone_form" }
							}
						}
					},
					{
						"brr_meme_factory": {
							"type": "panel",
							"factory": {
								"name": "server_form_factory",
								"control_ids": {
									"long_form": "@server_form.brr_meme_form"
								}
							}
						}
					}
				]
			}
		]
	},

	// title "brr:meme:<pool>/<slug>" -> textures/memes/<pool>/<slug>(.png + .json), see BP/scripts/memes.js
	// the "cutscene" pool plays full screen on solid black with no close button
	"brr_meme_form": {
		"type": "panel",
		"size": [ "100%", "100%" ],
		"bindings": [
			{ "binding_name": "#title_text" },
			{
				"binding_type": "view",
				"source_property_name": "(not (((#title_text - 'brr:meme:') - 'brr:meme') = #title_text))",
				"target_property_name": "#visible"
			}
		],
		"controls": [
			{
				"backdrop": {
					"type": "image",
					"texture": "textures/ui/Black",
					"size": [ "100%", "100%" ],
					"alpha": 0.9,
					"layer": 1
				}
			},
			{
				"cutscene_backdrop": {
					"type": "image",
					"texture": "textures/ui/Black",
					"size": [ "100%", "100%" ],
					"layer": 1,
					"bindings": [
						{ "binding_name": "#title_text" },
						{
							"binding_type": "view",
							"source_property_name": "(not (((((#title_text - 'brr:meme:') - 'brr:meme') - 'cutscene/') = ((#title_text - 'brr:meme:') - 'brr:meme'))))",
							"target_property_name": "#visible"
						}
					]
				}
			},
			{ "video@server_form.brr_meme_parts": {
				"size": [ "177.78%y", "80%" ],
				"bindings": [
					{ "binding_name": "#title_text" },
					{
						"binding_type": "view",
						"source_property_name": "((((#title_text - 'brr:meme:') - 'brr:meme') - 'cutscene/') = ((#title_text - 'brr:meme:') - 'brr:meme'))",
						"target_property_name": "#visible"
					}
				]
			} },
			{ "cutscene_video@server_form.brr_meme_parts": {
				"size": [ "177.78%y", "100%" ],
				"bindings": [
					{ "binding_name": "#title_text" },
					{
						"binding_type": "view",
						"source_property_name": "(not ((((#title_text - 'brr:meme:') - 'brr:meme') - 'cutscene/') = ((#title_text - 'brr:meme:') - 'brr:meme')))",
						"target_property_name": "#visible"
					}
				]
			} },
			{ "close@server_form.brr_meme_close_button": {} }
		]
	},

	"brr_gameboy_form": {
		"type": "panel",
		"size": [ "100%", "100%" ],
		"bindings": [
			{ "binding_name": "#title_text" },
			{ "binding_type": "view", "source_property_name": "(#title_text = 'brr:gameboy')", "target_property_name": "#visible" }
		],
		"controls": [
			{
				"gameboy": {
					"type": "panel",
					"size": [ "60.377%y", "86%" ],
					"controls": [
						{
							"video": {
								"type": "image",
								"texture": "textures/memes/item/gameboyvideo",
								"anchor_from": "top_left", "anchor_to": "top_left",
								"offset": [ "22%", "15.1%" ],
								"size": [ "55.5%", "25.1%" ],
								"uv_size": [ 160, 120 ],
								"uv": "@server_form.brr_meme_flipbook",
								"disable_anim_fast_forward": true,
								"layer": 3
							}
						},
						{
							"frame": {
								"type": "image", "texture": "textures/ui/GameBoyColor",
								"size": [ "100%", "100%" ], "layer": 2
							}
						}
					]
				}
			},
			{ "close@server_form.brr_meme_close_button": {} }
		]
	},

	"brr_phone_form": {
		"type": "panel",
		"size": [ "66.093%y", "76%" ],
		"offset": [ 0, 8 ],
		"bindings": [
			{ "binding_name": "#title_text" },
			{ "binding_type": "view", "source_property_name": "(#title_text = 'brr:phone')", "target_property_name": "#visible" }
		],
		"controls": [
			// fills the transparent screen opening of Phone.png (x 18.6-82.1%, y 2.8-93.7%)
			{
				"wallpaper": {
					"type": "image", "texture": "textures/ui/phone/HomeScreen",
					"anchor_from": "top_left", "anchor_to": "top_left",
					"offset": [ "18%", "2.4%" ], "size": [ "64.6%", "91.6%" ], "layer": 2
				}
			},
			{
				"phone_frame": {
					"type": "image", "texture": "textures/ui/phone/Phone",
					"size": [ "100%", "100%" ], "layer": 3
				}
			},
			// 2x2 cells filled row-first: Call, Ping / Quit
			{
				"apps": {
					"type": "grid",
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"offset": [ "20.9%", "29.6%" ],
					"size": [ "64.4%", "50%" ],
					"layer": 4,
					"grid_dimensions": [ 2, 2 ],
					"maximum_grid_items": 3,
					"grid_item_template": "server_form.brr_phone_cell",
					"collection_name": "form_buttons"
				}
			}
		]
	},

	"brr_phone_icon": {
		"type": "image",
		"texture": "#texture",
		"size": [ "100%", "100%" ],
		"bindings": [
			{ "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_texture", "binding_name_override": "#texture" }
		]
	},

	"brr_phone_hover": {
		"type": "panel",
		"size": [ "100%", "100%" ],
		"controls": [
			{ "icon@server_form.brr_phone_icon": {} },
			{
				"tooltip_background": {
					"type": "image", "texture": "textures/ui/Black", "alpha": 0.6,
					"size": [ "175%", "55%" ], "anchor_from": "bottom_middle", "anchor_to": "center",
					"offset": [ 0, -4 ], "layer": 7
				}
			},
			{
				"tooltip": {
					"type": "label", "text": "#text", "localize": false,
					"shadow": true, "text_alignment": "center", "font_size": "normal",
					"size": [ "165%", "default" ], "anchor_from": "bottom_middle", "anchor_to": "center",
					"offset": [ 0, -4 ], "layer": 8,
					"bindings": [
						{ "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_name_override": "#text" }
					]
				}
			}
		]
	},

	// grid item sizes are relative to the whole grid
	"brr_phone_cell": {
		"type": "panel",
		"size": [ "50%", "50%" ],
		"controls": [ { "button@server_form.brr_phone_button": {} } ]
	},

	"brr_phone_button": {
		"type": "button",
		"size": [ "83.85%", "100%x" ],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"default_control": "default",
		"hover_control": "hover",
		"pressed_control": "pressed",
		"button_mappings": [
			{ "from_button_id": "button.menu_select", "to_button_id": "button.form_button_click", "mapping_type": "pressed" },
			{ "from_button_id": "button.menu_ok", "to_button_id": "button.form_button_click", "mapping_type": "focused" }
		],
		"bindings": [
			{ "binding_type": "collection_details", "binding_collection_name": "form_buttons" }
		],
		"controls": [
			{ "default@server_form.brr_phone_icon": {} },
			{ "hover@server_form.brr_phone_hover": {} },
			{ "pressed@server_form.brr_phone_hover": {} }
		]
	},

	"brr_meme_flipbook": {
		"anim_type": "aseprite_flip_book",
		"initial_uv": [ 0, 0 ]
	},

	// one video frame; uv_size must match FRAME_SIZE in scripts_gen/make_meme_sheets.mjs
	"brr_meme_part": {
		"type": "image",
		"texture": "#texture",
		"size": [ "100%", "100%" ],
		"uv_size": [ 384, 216 ],
		"uv": "@server_form.brr_meme_flipbook",
		"disable_anim_fast_forward": true
	},

	// A meme too long for one sheet is split into parts (title "brr:meme:<id>_p2_p3..."). All parts
	// start together; part N waits on a transparent cell until the earlier parts have played, then
	// draws over them, so later parts sit on higher layers. Part 1's texture is the id with the
	// markers removed; up to 6 parts, matching MAX_PARTS in the generator.
	"brr_meme_parts": {
		"type": "panel",
		"controls": [
				{ "part_1@server_form.brr_meme_part": { "layer": 2, "bindings": [ { "binding_name": "#title_text" }, { "binding_type": "view", "source_property_name": "('textures/memes/' + (((((((#title_text - 'brr:meme:') - 'brr:meme') - '_p2') - '_p3') - '_p4') - '_p5') - '_p6'))", "target_property_name": "#texture" } ] } },
				{ "part_2@server_form.brr_meme_part": { "layer": 3, "bindings": [ { "binding_name": "#title_text" }, { "binding_type": "view", "source_property_name": "('textures/memes/' + (((((((#title_text - 'brr:meme:') - 'brr:meme') - '_p2') - '_p3') - '_p4') - '_p5') - '_p6') + '_p2')", "target_property_name": "#texture" }, { "binding_type": "view", "source_property_name": "(not ((((#title_text - 'brr:meme:') - 'brr:meme') - '_p2') = ((#title_text - 'brr:meme:') - 'brr:meme')))", "target_property_name": "#visible" } ] } },
				{ "part_3@server_form.brr_meme_part": { "layer": 4, "bindings": [ { "binding_name": "#title_text" }, { "binding_type": "view", "source_property_name": "('textures/memes/' + (((((((#title_text - 'brr:meme:') - 'brr:meme') - '_p2') - '_p3') - '_p4') - '_p5') - '_p6') + '_p3')", "target_property_name": "#texture" }, { "binding_type": "view", "source_property_name": "(not ((((#title_text - 'brr:meme:') - 'brr:meme') - '_p3') = ((#title_text - 'brr:meme:') - 'brr:meme')))", "target_property_name": "#visible" } ] } },
				{ "part_4@server_form.brr_meme_part": { "layer": 5, "bindings": [ { "binding_name": "#title_text" }, { "binding_type": "view", "source_property_name": "('textures/memes/' + (((((((#title_text - 'brr:meme:') - 'brr:meme') - '_p2') - '_p3') - '_p4') - '_p5') - '_p6') + '_p4')", "target_property_name": "#texture" }, { "binding_type": "view", "source_property_name": "(not ((((#title_text - 'brr:meme:') - 'brr:meme') - '_p4') = ((#title_text - 'brr:meme:') - 'brr:meme')))", "target_property_name": "#visible" } ] } },
				{ "part_5@server_form.brr_meme_part": { "layer": 6, "bindings": [ { "binding_name": "#title_text" }, { "binding_type": "view", "source_property_name": "('textures/memes/' + (((((((#title_text - 'brr:meme:') - 'brr:meme') - '_p2') - '_p3') - '_p4') - '_p5') - '_p6') + '_p5')", "target_property_name": "#texture" }, { "binding_type": "view", "source_property_name": "(not ((((#title_text - 'brr:meme:') - 'brr:meme') - '_p5') = ((#title_text - 'brr:meme:') - 'brr:meme')))", "target_property_name": "#visible" } ] } },
				{ "part_6@server_form.brr_meme_part": { "layer": 7, "bindings": [ { "binding_name": "#title_text" }, { "binding_type": "view", "source_property_name": "('textures/memes/' + (((((((#title_text - 'brr:meme:') - 'brr:meme') - '_p2') - '_p3') - '_p4') - '_p5') - '_p6') + '_p6')", "target_property_name": "#texture" }, { "binding_type": "view", "source_property_name": "(not ((((#title_text - 'brr:meme:') - 'brr:meme') - '_p6') = ((#title_text - 'brr:meme:') - 'brr:meme')))", "target_property_name": "#visible" } ] } }
		]
	},

	"brr_meme_close_image": {
		"type": "image",
		"texture": "textures/ui/ExitSheet",
		"size": [ "100%", "100%" ],
		"uv": "$close_uv",
		"uv_size": [ 130, 130 ]
	},

	// ExitSheet.png: normal state on the left half, hover state on the right half
	"brr_meme_close_button": {
		"type": "button",
		"size": [ 28, 28 ],
		"anchor_from": "top_right",
		"anchor_to": "top_right",
		"offset": [ -6, 6 ],
		"layer": 10,
		"default_control": "default",
		"hover_control": "hover",
		"pressed_control": "pressed",
		"sound_name": "random.click",
		"sound_volume": 1.0,
		"button_mappings": [
			{
				"from_button_id": "button.menu_select",
				"to_button_id": "button.menu_exit",
				"mapping_type": "pressed"
			},
			{
				"from_button_id": "button.menu_ok",
				"to_button_id": "button.menu_exit",
				"mapping_type": "focused"
			}
		],
		"controls": [
			{ "default@server_form.brr_meme_close_image": { "$close_uv": [ 0, 0 ] } },
			{ "hover@server_form.brr_meme_close_image": { "$close_uv": [ 130, 0 ] } },
			{ "pressed@server_form.brr_meme_close_image": { "$close_uv": [ 130, 0 ] } }
		],
		"bindings": [
			{ "binding_name": "#title_text" },
			{
				"binding_type": "view",
				"source_property_name": "(((((#title_text - 'brr:meme:') - 'brr:meme') - 'cutscene/') = ((#title_text - 'brr:meme:') - 'brr:meme')))",
				"target_property_name": "#visible"
			}
		]
	}
}
