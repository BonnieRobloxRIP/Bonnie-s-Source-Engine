            "100% - 8px"
          ],
          "offset": [
            -2,
            0
          ],
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "layer": 10,
          "controls": [
            {
              "centered_panel": {
                "type": "panel",
                "size": [
                  "100%",
                  "100%"
                ],
                "anchor_from": "center",
                "anchor_to": "center",
                "controls": [
                  {
                    "track": {
                      "type": "scroll_track",
                      "anchor_from": "center",
