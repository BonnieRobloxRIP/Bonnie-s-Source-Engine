                          "mapping_type": "pressed"
                        }
                      ]
                    }
                  },
                  {
                    "scroll_box": {
                      "type": "panel",
                      "controls": [
                        {
                          "box": {
                            "type": "scrollbar_box",
                            "layer": 5,
                            "anchor_from": "top_middle",
                            "anchor_to": "top_middle",
                            "contained": true,
                            "draggable": "vertical",
                            "button_mappings": [
                              {
                                "from_button_id": "button.menu_select",
                                "to_button_id": "button.menu_select",
                                "mapping_type": "pressed",
                                "button_up_right_of_first_refusal": true
                              }
                            ],
                            "controls": [
                              {
                                "thumb": {
                                  "type": "image",
                                  "texture": "textures/ui/black_mesa/menu/shapes/solid",
                                  "color": [
                                    0.894,
                                    0.443,
                                    0.145
                                  ],
                                  "keep_ratio": false,
                                  "size": [
                                    "100%",
                                    "100%"
                                  ],
                                  "layer": 6
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
