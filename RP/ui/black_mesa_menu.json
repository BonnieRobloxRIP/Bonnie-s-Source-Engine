{
  "namespace": "server_form",

  "third_party_server_screen@common.base_screen": {
    "$screen_content": "server_form.main_screen_content",
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ]
  },

  "main_screen_content": {
    "type": "panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": ["100%", "100%"],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.long_form",
            "custom_form": "@server_form.custom_form"
          }
        }
      }
    ]
  },

  "long_form": {
    "type": "panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [0, 0],
    "size": ["100%", "100%"],
    "controls": [
      {
        "default_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": ["100% - 14px", 10],
          "size": [225, 200],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.long_form_panel",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text = 'BM_MAIN::HUB') or (#title_text = 'BM_MAIN::CAMPAIGN::0') or (#title_text = 'BM_MAIN::CAMPAIGN::1') or (#title_text = 'BM_MAIN::CAMPAIGN::2') or (#title_text = 'BM_MAIN::CAMPAIGN::3')))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "black_mesa_long_form@server_form.black_mesa_long_form": {}
      }
    ]
  },

  "black_mesa_long_form": {
    "type": "panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [0, 0],
    "size": ["100%", "100%"],
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "((#title_text = 'BM_MAIN::HUB') or (#title_text = 'BM_MAIN::CAMPAIGN::0') or (#title_text = 'BM_MAIN::CAMPAIGN::1') or (#title_text = 'BM_MAIN::CAMPAIGN::2') or (#title_text = 'BM_MAIN::CAMPAIGN::3'))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "bm_dimmer": {
          "type": "image",
          "size": ["100%", "100%"],
          "texture": "textures/ui/main_bg",
          "alpha": 0.58,
          "layer": 0
        }
      },
      {
        "bm_top_ribbon": {
          "type": "image",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [0, 0],
          "size": [620, 46],
          "texture": "textures/ui/black_mesa/bm_mainmenu_ribbon",
          "layer": 3,
          "controls": [
            {
              "bm_tab_row": {
                "type": "stack_panel",
                "orientation": "horizontal",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [56, 9],
                "size": [560, 22],
                "layer": 5,
                "collection_name": "form_buttons",
                "controls": [
                  { "tab0@server_form.bm_tab_button": { "$button_size": [96, 22] } },
                  { "tab1@server_form.bm_tab_button": { "$button_size": [96, 22] } },
                  { "tab2@server_form.bm_tab_button": { "$button_size": [96, 22] } },
                  { "tab3@server_form.bm_tab_button": { "$button_size": [96, 22] } },
                  { "tab4@server_form.bm_tab_button": { "$button_size": [120, 22] } }
                ]
              }
            }
          ]
        }
      },
      {
        "bm_hub_state": {
          "type": "panel",
          "size": ["100%", "100%"],
          "layer": 6,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = 'BM_MAIN::HUB')",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "bm_logo_label": {
                "type": "label",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [56, 352],
                "text": "BLACK MESA",
                "font_type": "MinecraftTen",
                "font_scale_factor": 1.85,
                "color": [1, 1, 1],
                "shadow": false,
                "layer": 7
              }
            },
            {
              "bm_hub_text": {
                "type": "label",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [56, 410],
                "size": [640, 82],
                "text_alignment": "left",
                "text": "#form_text",
                "font_type": "MinecraftTen",
                "font_scale_factor": 0.85,
                "color": [1, 1, 1],
                "shadow": false,
                "layer": 7,
                "bindings": [
                  {
                    "binding_name": "#form_text"
                  }
                ]
              }
            },
            {
              "bm_resume_button@server_form.bm_collection_button": {
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [56, 525],
                "$button_size": [132, 36],
                "$font_type": "MinecraftTen",
                "$font_scale_factor": 0.75,
                "$default_text_color": [1, 1, 1],
                "$hover_text_color": [1, 1, 1],
                "$pressed_text_color": [1, 1, 1],
                "$default_button_texture": "textures/ui/black_mesa/bm_mainmenu_button",
                "$hover_button_texture": "textures/ui/black_mesa/bm_mainmenu_button",
                "$pressed_button_texture": "textures/ui/black_mesa/bm_mainmenu_button",
                "$default_button_alpha": 1,
                "$hover_button_alpha": 1,
                "$pressed_button_alpha": 1
              }
            },
            {
              "bm_quit_button@server_form.bm_collection_button": {
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "offset": [24, -14],
                "$button_size": [80, 20],
                "$font_type": "MinecraftTen",
                "$font_scale_factor": 0.72,
                "$default_text_color": [1, 1, 1],
                "$hover_text_color": [1, 0.66, 0.37],
                "$pressed_text_color": [1, 0.66, 0.37],
                "$default_button_texture": "textures/ui/main_bg",
                "$hover_button_texture": "textures/ui/main_bg",
                "$pressed_button_texture": "textures/ui/main_bg",
                "$default_button_alpha": 0,
                "$hover_button_alpha": 0,
                "$pressed_button_alpha": 0
              }
            }
          ]
        }
      },
      {
        "bm_campaign_state": {
          "type": "panel",
          "size": ["100%", "100%"],
          "layer": 6,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text = 'BM_MAIN::CAMPAIGN::0') or (#title_text = 'BM_MAIN::CAMPAIGN::1') or (#title_text = 'BM_MAIN::CAMPAIGN::2') or (#title_text = 'BM_MAIN::CAMPAIGN::3'))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "bm_campaign_overlay": {
                "type": "image",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [0, 58],
                "size": ["100%", "100% - 110px"],
                "texture": "textures/ui/main_bg",
                "alpha": 0.35,
                "layer": 1
              }
            },
            {
              "bm_campaign_caption": {
                "type": "label",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [104, 210],
                "size": [700, 24],
                "text_alignment": "left",
                "text": "#form_text",
                "font_type": "MinecraftTen",
                "font_scale_factor": 0.8,
                "color": [0.96, 0.96, 0.96],
                "shadow": false,
                "layer": 7,
                "bindings": [
                  {
                    "binding_name": "#form_text"
                  }
                ]
              }
            },
            {
              "bm_card_row": {
                "type": "panel",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [104, 262],
                "size": [1120, 194],
                "layer": 7,
                "controls": [
                  {
                    "chapter_0@server_form.bm_chapter_card": {
                      "$offset": [0, 0],
                      "$chapter_text": "CHAPTER 1",
                      "$selected_title": "BM_MAIN::CAMPAIGN::0"
                    }
                  },
                  {
                    "chapter_1@server_form.bm_chapter_card": {
                      "$offset": [290, 0],
                      "$chapter_text": "CHAPTER 2",
                      "$selected_title": "BM_MAIN::CAMPAIGN::1"
                    }
                  },
                  {
                    "chapter_2@server_form.bm_chapter_card": {
                      "$offset": [580, 0],
                      "$chapter_text": "CHAPTER 3",
                      "$selected_title": "BM_MAIN::CAMPAIGN::2"
                    }
                  },
                  {
                    "chapter_3@server_form.bm_chapter_card": {
                      "$offset": [870, 0],
                      "$chapter_text": "CHAPTER 4",
                      "$selected_title": "BM_MAIN::CAMPAIGN::3"
                    }
                  }
                ]
              }
            },
            {
              "bm_campaign_back@server_form.bm_collection_button": {
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "offset": [90, -14],
                "$button_size": [94, 20],
                "$font_type": "MinecraftTen",
                "$font_scale_factor": 0.72,
                "$default_text_color": [1, 1, 1],
                "$hover_text_color": [1, 0.66, 0.37],
                "$pressed_text_color": [1, 0.66, 0.37],
                "$default_button_texture": "textures/ui/main_bg",
                "$hover_button_texture": "textures/ui/main_bg",
                "$pressed_button_texture": "textures/ui/main_bg",
                "$default_button_alpha": 0,
                "$hover_button_alpha": 0,
                "$pressed_button_alpha": 0
              }
            },
            {
              "bm_campaign_start@server_form.bm_collection_button": {
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [112, 508],
                "$button_size": [132, 36],
                "$font_type": "MinecraftTen",
                "$font_scale_factor": 0.75,
                "$default_text_color": [1, 1, 1],
                "$hover_text_color": [1, 1, 1],
                "$pressed_text_color": [1, 1, 1],
                "$default_button_texture": "textures/ui/black_mesa/bm_mainmenu_button",
                "$hover_button_texture": "textures/ui/black_mesa/bm_mainmenu_button",
                "$pressed_button_texture": "textures/ui/black_mesa/bm_mainmenu_button",
                "$default_button_alpha": 1,
                "$hover_button_alpha": 1,
                "$pressed_button_alpha": 1
              }
            },
            {
              "bm_campaign_arrow": {
                "type": "image",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [1238, 328],
                "size": [42, 64],
                "texture": "textures/ui/black_mesa/bm_mainmenu_right_arrow",
                "layer": 8
              }
            }
          ]
        }
      },
      {
        "bm_bottom_bar": {
          "type": "image",
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "offset": [0, 0],
          "size": ["100%", 52],
          "texture": "textures/ui/black_mesa/bm_mainmenu_bottom_bar",
          "layer": 9
        }
      },
      {
        "bm_hint_text": {
          "type": "label",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [0, -12],
          "size": [860, 22],
          "text_alignment": "center",
          "text": "A  D   NAVIGATE     [ARROWS]  CHANGE OPTIONS     [BACK]  DISCARD/BACK     [ENTER]  SELECT",
          "font_type": "MinecraftTen",
          "font_scale_factor": 0.68,
          "color": [1, 1, 1],
          "shadow": false,
          "layer": 10
        }
      }
    ]
  },

  "bm_collection_button": {
    "type": "button",
    "$button_size|default": [100, 20],
    "$pressed_button_name|default": "button.form_button_click",
    "$font_type|default": "MinecraftTen",
    "$font_scale_factor|default": 0.72,
    "$label_offset|default": [0, -1],
    "$default_text_color|default": [1, 1, 1],
    "$hover_text_color|default": [1, 1, 1],
    "$pressed_text_color|default": [1, 1, 1],
    "$default_button_texture|default": "textures/ui/main_bg",
    "$hover_button_texture|default": "textures/ui/main_bg",
    "$pressed_button_texture|default": "textures/ui/main_bg",
    "$default_button_alpha|default": 0,
    "$hover_button_alpha|default": 0,
    "$pressed_button_alpha|default": 0,
    "size": "$button_size",
    "sound_name": "random.click",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "focused"
      }
    ],
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      {
        "default": {
          "type": "panel",
          "size": ["100%", "100%"],
          "controls": [
            {
              "bg": {
                "type": "image",
                "size": ["100%", "100%"],
                "texture": "$default_button_texture",
                "alpha": "$default_button_alpha"
              }
            },
            {
              "label": {
                "type": "label",
                "anchor_from": "center",
                "anchor_to": "center",
                "offset": "$label_offset",
                "size": ["100%", "default"],
                "text_alignment": "center",
                "text": "#button_text",
                "font_type": "$font_type",
                "font_scale_factor": "$font_scale_factor",
                "color": "$default_text_color",
                "shadow": false,
                "bindings": [
                  {
                    "binding_name": "#form_button_text",
                    "binding_name_override": "#button_text",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "hover": {
          "type": "panel",
          "size": ["100%", "100%"],
          "controls": [
            {
              "bg": {
                "type": "image",
                "size": ["100%", "100%"],
                "texture": "$hover_button_texture",
                "alpha": "$hover_button_alpha"
              }
            },
            {
              "label": {
                "type": "label",
                "anchor_from": "center",
                "anchor_to": "center",
                "offset": "$label_offset",
                "size": ["100%", "default"],
                "text_alignment": "center",
                "text": "#button_text",
                "font_type": "$font_type",
                "font_scale_factor": "$font_scale_factor",
                "color": "$hover_text_color",
                "shadow": false,
                "bindings": [
                  {
                    "binding_name": "#form_button_text",
                    "binding_name_override": "#button_text",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "pressed": {
          "type": "panel",
          "size": ["100%", "100%"],
          "controls": [
            {
              "bg": {
                "type": "image",
                "size": ["100%", "100%"],
                "texture": "$pressed_button_texture",
                "alpha": "$pressed_button_alpha"
              }
            },
            {
              "label": {
                "type": "label",
                "anchor_from": "center",
                "anchor_to": "center",
                "offset": "$label_offset",
                "size": ["100%", "default"],
                "text_alignment": "center",
                "text": "#button_text",
                "font_type": "$font_type",
                "font_scale_factor": "$font_scale_factor",
                "color": "$pressed_text_color",
                "shadow": false,
                "bindings": [
                  {
                    "binding_name": "#form_button_text",
                    "binding_name_override": "#button_text",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "bm_tab_hover_wipe_in": {
    "anim_type": "clip",
    "from": 0,
    "to": 1,
    "duration": 0.12,
    "easing": "out_quad"
  },

  "bm_tab_click_button@common.button": {
    "$button_size|default": [96, 22],
    "size": "$button_size",
    "$pressed_button_name": "button.form_button_click",
    "$button_bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      {
        "default@common.empty_panel": {}
      },
      {
        "hover": {
          "type": "image",
          "size": ["100%", "100%"],
          "texture": "textures/ui/main_bg",
          "color": [1, 1, 1],
          "alpha": 0.5,
          "clip_direction": "down",
          "clip_ratio": 0,
          "clip_pixelperfect": false,
          "anims": [
            "@server_form.bm_tab_hover_wipe_in"
          ]
        }
      },
      {
        "pressed": {
          "type": "image",
          "size": ["100%", "100%"],
          "texture": "textures/ui/main_bg",
          "color": [1, 1, 1],
          "alpha": 0.6
        }
      }
    ]
  },

  "bm_tab_button": {
    "type": "panel",
    "$button_size|default": [96, 22],
    "size": "$button_size",
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      {
        "tab_label": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [0, -1],
          "size": ["100%", "default"],
          "text_alignment": "center",
          "text": "#tab_text",
          "font_type": "MinecraftTen",
          "font_scale_factor": 0.67,
          "color": [1, 1, 1],
          "shadow": false,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_name_override": "#tab_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      },
      {
        "tab_active_line": {
          "type": "image",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [0, 11],
          "size": [82, 4],
          "texture": "textures/ui/black_mesa/bm_tab_active",
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "((#tab_text = 'CAMPAIGN') and ((#title_text = 'BM_MAIN::CAMPAIGN::0') or (#title_text = 'BM_MAIN::CAMPAIGN::1') or (#title_text = 'BM_MAIN::CAMPAIGN::2') or (#title_text = 'BM_MAIN::CAMPAIGN::3')))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "tab_click@server_form.bm_tab_click_button": {
          "$button_size": "$button_size"
        }
      }
    ]
  },

  "bm_chapter_card": {
    "type": "panel",
    "$offset|default": [0, 0],
    "$panel_size|default": [286, 194],
    "$chapter_text|default": "CHAPTER",
    "$selected_title|default": "BM_MAIN::CAMPAIGN::0",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": "$panel_size",
    "offset": "$offset",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#title_text"
      }
    ],
    "controls": [
      {
        "card_frame": {
          "type": "image",
          "size": "$panel_size",
          "texture": "textures/ui/black_mesa/bm_chapter_card",
          "alpha": 0.56,
          "layer": 1
        }
      },
      {
        "card_frame_selected": {
          "type": "image",
          "size": "$panel_size",
          "texture": "textures/ui/black_mesa/bm_chapter_card",
          "alpha": 1.0,
          "layer": 2,
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = $selected_title)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "card_thumb": {
          "type": "image",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [8, 8],
          "size": [270, 112],
          "texture": "textures/ui/main_bg",
          "alpha": 0.32,
          "layer": 3
        }
      },
      {
        "card_title": {
          "type": "label",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [8, 127],
          "size": [270, 20],
          "text_alignment": "left",
          "text": "#chapter_title",
          "font_type": "MinecraftTen",
          "font_scale_factor": 0.86,
          "color": [1, 1, 1],
          "shadow": false,
          "layer": 4,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_name_override": "#chapter_title",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      },
      {
        "card_chapter_label": {
          "type": "label",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [8, 152],
          "size": [270, 16],
          "text_alignment": "left",
          "text": "$chapter_text",
          "font_type": "MinecraftTen",
          "font_scale_factor": 0.66,
          "color": [0.75, 0.75, 0.75],
          "shadow": false,
          "layer": 4
        }
      },
      {
        "card_click@server_form.bm_collection_button": {
          "$button_size": "$panel_size"
        }
      }
    ]
  }
}
