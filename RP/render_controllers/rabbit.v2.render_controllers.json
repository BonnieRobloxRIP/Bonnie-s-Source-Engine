{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.rabbit.v2": {
			"arrays": {
				"textures": {
					"Array.skins": [
						"Texture.brown",
						"Texture.white",
						"Texture.black",
						"Texture.white_splotched",
						"Texture.gold",
						"Texture.salt"
					],
					"Array.baby_skins": [
						"Texture.baby_brown",
						"Texture.baby_white",
						"Texture.baby_black",
						"Texture.baby_white_splotched",
						"Texture.baby_gold",
						"Texture.baby_salt"
					]
				}
			},
			"geometry": "query.is_baby?geometry.baby:geometry.default",
			"materials": [
				{
					"*": "material.default"
				}
			],
			"textures": [
				"query.is_name_any('Toast')?query.is_baby?texture.baby_toast:texture.toast:query.is_baby?array.baby_skins[query.variant]:array.skins[query.variant]"
			]
		}
	}
}