{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.brr.alarm_clock": {
			"geometry": "Geometry.default",
			"materials": [
				{
					"*": "Material.default"
				}
			],
			"textures": [
				"Texture.default"
			],
			"part_visibility": [
				{
					"frame_*": false
				},
				{
					"frame_0": "q.property('brr:frame') == 0"
				},
				{
					"frame_1": "q.property('brr:frame') == 1"
				},
				{
					"frame_2": "q.property('brr:frame') == 2"
				},
				{
					"frame_3": "q.property('brr:frame') == 3"
				}
			]
		}
	}
}