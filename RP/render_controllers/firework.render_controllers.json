			}
		},
		"controller.render.brr.firework_spark": {
			"geometry": "Geometry.spark",
			"materials": [{ "*": "Material.default" }],
			"textures": ["Texture.spark"],
			"uv_anim": {
				"offset": ["math.mod(v.frame, 4.0) / 4.0", "math.floor(v.frame / 4.0) / 4.0"],
				"scale": [0.25, 0.25]
			}
		}
	}
}
