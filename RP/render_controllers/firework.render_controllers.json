{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.brr.firework": {
			"geometry": "Geometry.default",
			"materials": [{ "*": "Material.default" }],
			"textures": ["Texture.default"],
			"uv_anim": {
				"offset": ["math.mod(v.frame, 4.0) / 4.0", "math.floor(v.frame / 4.0) / 4.0"],
