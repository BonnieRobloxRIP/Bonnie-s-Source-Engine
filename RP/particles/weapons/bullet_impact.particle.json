{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "brr:bullet_impact",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/brr_bullet_debris"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.random_integer(5, 8)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_point": {
				"direction": [
					"variable.normal.x * 1.2 + math.random(-0.55, 0.55)",
					"variable.normal.y * 1.2 + math.random(-0.55, 0.55) + 0.35",
					"variable.normal.z * 1.2 + math.random(-0.55, 0.55)"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.35, 0.7)"
			},
			"minecraft:particle_initial_speed": "math.random(1.5, 4.0)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -14, 0],
				"linear_drag_coefficient": 1.5
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 4,
				"coefficient_of_restitution": 0.2,
				"collision_radius": 0.03
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.03 + variable.particle_random_1 * 0.035", "0.03 + variable.particle_random_1 * 0.035"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 8,
					"texture_height": 8,
					"uv": ["math.floor(variable.particle_random_2 * 6)", "math.floor(variable.particle_random_3 * 6)"],
					"uv_size": [2, 2]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"variable.color.r * (0.75 + variable.particle_random_4 * 0.25)",
					"variable.color.g * (0.75 + variable.particle_random_4 * 0.25)",
					"variable.color.b * (0.75 + variable.particle_random_4 * 0.25)",
					1
				]
			},
			"minecraft:particle_appearance_lighting": {}
		}
	}
