		"controller.animation.scientist_01.land": {
			"initial_state": "grounded",
			"states": {
				"grounded": {
					"transitions": [
						{
							"airborne": "!q.is_on_ground && q.is_alive"
						}
					]
				},
				"airborne": {
					"on_entry": [
						"v.air_start = q.life_time;"
					],
					"transitions": [
						{
							"landing": "q.is_on_ground && (q.life_time - v.air_start) > 0.25"
						},
						{
							"grounded": "q.is_on_ground"
						}
					]
				},
				"landing": {
					"on_entry": [
						"v.land_strength = math.clamp((q.life_time - v.air_start) * 1.5, 0.35, 1.0);"
					],
					"animations": [
						"land"
					],
					"transitions": [
						{
							"airborne": "!q.is_on_ground"
						},
						{
							"grounded": "q.all_animations_finished"
						}
					]
				}
			}
		}
	}
