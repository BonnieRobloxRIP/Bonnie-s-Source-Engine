{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.gluon_gun.firstPerson": {
			"initial_state": "hidden",
			"states": {
				"hidden": {
					"animations": [
						"fp_hidden"
					]
				}
			}
		},
		"controller.animation.gluon_gun.thirdPerson": {
			"initial_state": "hidden",
			"states": {
				"hidden": {
					"animations": [
						"fp_hidden"
					],
					"transitions": [
						{
							"held_by_other": "!q.is_owner_identifier_any('minecraft:player')"
						}
					]
				},
				"held_by_other": {
					"animations": [
						"tp_idle"
					],
					"transitions": [
						{
							"hidden": "q.is_owner_identifier_any('minecraft:player')"
						}
					]
				}
			}
		}
	}
}
