					],
					"transitions": [
						{
							"tp_idle_to_centerfire": "query.any_animation_finished&&query.is_sneaking"
						},
						{
							"tp_idle": "query.any_animation_finished"
						}
					]
				},
				"tp_draw": {
					"animations": [
						"tp_draw"
					],
					"transitions": [
						{
							"tp_reload": "query.mark_variant==1"
						},
						{
							"tp_idle_to_centerfire": "query.any_animation_finished&&query.is_sneaking"
						},
						{
							"tp_idle": "query.any_animation_finished"
						}
					]
				},
				"tp_idle": {
					"animations": [
						"tp_idle"
					],
					"transitions": [
						{
							"tp_reload": "query.mark_variant==1"
						},
						{
							"tp_idle_to_centerfire": "query.is_sneaking"
						},
						{
							"tp_idle_fidget": "query.anim_time>=10&&math.random(0,1)<0.001"
						}
					]
				},
				"tp_idle_fidget": {
					"animations": [
						"tp_idle_fidget"
					],
					"transitions": [
						{
							"tp_reload": "query.mark_variant==1"
						},
						{
							"tp_idle_to_centerfire": "query.is_sneaking"
						},
						{
							"tp_idle": "query.any_animation_finished"
						}
					]
				},
				"tp_idle_to_centerfire": {
					"animations": [
						"tp_idle_to_centerfire"
					],
					"transitions": [
						{
							"tp_centerfire_idle": "query.any_animation_finished"
						}
					]
				},
				"tp_centerfire_idle": {
					"animations": [
						"tp_centerfire_idle"
					],
					"transitions": [
						{
							"tp_reload": "query.mark_variant==1"
						},
						{
							"tp_centerfire_to_idle": "!query.is_sneaking"
						}
					]
				},
				"tp_centerfire_to_idle": {
					"animations": [
						"tp_centerfire_to_idle"
					],
					"transitions": [
						{
							"tp_idle": "query.any_animation_finished"
						}
					]
				},
				"tp_reload": {
					"animations": [
						"tp_reload"
					],
					"transitions": [
						{
							"tp_idle_to_centerfire": "query.any_animation_finished&&query.is_sneaking"
						},
						{
							"tp_idle": "query.any_animation_finished"
						}
					]
				}
			}
		}
	}
}
