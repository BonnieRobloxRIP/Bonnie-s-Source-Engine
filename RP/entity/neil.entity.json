				{ "controller.render.brr.neil": "q.property('brr:dead') == 0" },
				{ "controller.render.brr.neil_dead": "q.property('brr:dead') == 1" }
			],
			"spawn_egg": { "texture": "brr_neil_spawn_egg" }
		}
	}
