			},
			"scripts": {
				"initialize": [
					"variable.eye_phase = math.random(0.0, 360.0);",
					"v.next_gesture = math.random(4.0, 10.0);",
					"v.react_seen = q.property('brr:react_n');",
					"v.guard = 0.0;",
					"v.state_start = 0.0;",
					"v.idle_yaw = q.body_y_rotation;",
					"v.prev_yaw = q.body_y_rotation;",
					"v.look_x = 0.0; v.look_y = 0.0; v.look_vx = 0.0; v.look_vy = 0.0;",
					"v.chest_x = 0.0; v.chest_y = 0.0; v.turn_rate = 0.0; v.speed_lag = 0.0; v.lean = 0.0; v.bank = 0.0;",
					"v.hp = q.health; v.hit_time = 0.0; v.hit_seen = 0.0; v.take_seen = 0.0;",
					"v.air_start = 0.0; v.land_strength = 0.0;"
				],
				"pre_animation": [
					"variable.moving = query.modified_move_speed > 0.05;",
					"t.dt = math.clamp(q.delta_time, 0.0, 0.1);",
					"t.tx = math.clamp(query.target_x_rotation, -30.0, 30.0);",
					"t.ty = math.clamp(query.target_y_rotation, -60.0, 60.0);",
					"v.look_vx = v.look_vx + ((t.tx - v.look_x) * 120.0 - v.look_vx * 14.0) * t.dt;",
					"v.look_vy = v.look_vy + ((t.ty - v.look_y) * 120.0 - v.look_vy * 14.0) * t.dt;",
					"v.look_x = v.look_x + v.look_vx * t.dt;",
					"v.look_y = v.look_y + v.look_vy * t.dt;",
					"t.chest_k = 1.0 - math.exp(-t.dt * 3.0);",
					"v.chest_x = v.chest_x + (t.tx - v.chest_x) * t.chest_k;",
					"v.chest_y = v.chest_y + (t.ty - v.chest_y) * t.chest_k;",
					"t.dyaw = math.mod(q.body_y_rotation - v.prev_yaw + 540.0, 360.0) - 180.0;",
					"v.prev_yaw = q.body_y_rotation;",
					"v.turn_rate = t.dt > 0.0001 ? v.turn_rate + (t.dyaw / t.dt - v.turn_rate) * (1.0 - math.exp(-t.dt * 8.0)) : v.turn_rate;",
					"v.bank = math.clamp(-v.turn_rate * 0.035 * math.min(q.modified_move_speed * 3.0, 1.0), -6.0, 6.0);",
					"v.speed_lag = v.speed_lag + (q.modified_move_speed - v.speed_lag) * (1.0 - math.exp(-t.dt * 3.0));",
					"v.lean = math.clamp((q.modified_move_speed - v.speed_lag) * 16.0, -6.0, 6.0);",
					"v.hit_time = q.health < v.hp ? q.life_time : v.hit_time;",
					"v.hp = q.health;",
					"v.turn_delta = math.mod(q.body_y_rotation - v.idle_yaw + 540.0, 360.0) - 180.0;",
					"t.guard = (q.property('brr:provoked') && q.is_alive && q.distance_from_camera < 7.0) ? 1.0 : 0.0;",
					"v.guard = v.guard + (t.guard - v.guard) * (1.0 - math.exp(-t.dt * 5.0));",
					"t.eye_lead_y = math.clamp((t.ty - v.look_y) * 0.03, -0.35, 0.35);",
					"t.eye_lead_x = math.clamp((t.tx - v.look_x) * 0.03, -0.25, 0.25);",
					"variable.eye_dart_x = math.sin(query.life_time * 1.3 + variable.eye_phase) * 0.2 - t.eye_lead_y;",
					"variable.eye_dart_y = math.sin(query.life_time * 0.9 + variable.eye_phase * 1.7) * 0.15 - t.eye_lead_x;",
					"variable.blink_random_cooldown = math.random(2.0, 6.0);",
					"variable.blink_cooldown = ((variable.blink_cooldown ?? 0) <= 0) ? variable.blink_random_cooldown : variable.blink_cooldown;",
					"variable.blink_cooldown = math.max(0, variable.blink_cooldown - query.delta_time);",
					"variable.should_blink = variable.blink_cooldown <= 0;"
				],
				"animate": [
					"general",
					{
						"look_at_target": "q.is_alive"
					},
					{
						"guarded": "v.guard > 0.01"
					},
					"eye_dart",
					"blink_controller",
					"take_controller",
					"land_controller"
				]
			},
			"render_controllers": [
				"controller.render.scientist_01"
			],
			"spawn_egg": {
				"texture": "brr_scientist_01_egg",
				"texture_index": 0
			}
		}
	}
