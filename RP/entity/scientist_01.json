{
	"format_version": "1.20.80",
	"minecraft:client_entity": {
		"description": {
			"identifier": "brr:scientist_01",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/entity/scientist_01"
			},
			"geometry": {
				"default": "geometry.scientist_01"
			},
			"animations": {
				"walk": "animation.scientist_01.walk",
				"idle": "animation.scientist_01.idle",
				"general": "controller.animation.scientist_01.general",
				"look_at_target": "animation.scientist_01.look_at_target",
				"eye_dart": "animation.scientist_01.eye_dart",
				"blink": "animation.scientist_01.blink",
				"blink_controller": "controller.animation.scientist_01.blink"
			},
			"scripts": {
				"initialize": [
					"variable.eye_phase = math.random(0.0, 360.0);"
				],
				"pre_animation": [
					"variable.moving = query.modified_move_speed > 0.05;",
					"variable.head_walk_sway = variable.moving ? math.sin(query.life_time * 76.34) * 3.0 : 0.0;",
					"variable.head_rot_x = math.clamp(query.target_x_rotation, -30.0, 30.0);",
					"variable.head_rot_y = math.clamp(query.target_y_rotation, -50.0, 50.0) + variable.head_walk_sway;",
					"variable.eye_dart_x = math.sin(query.life_time * 1.3 + variable.eye_phase) * 0.2;",
					"variable.eye_dart_y = math.sin(query.life_time * 0.9 + variable.eye_phase * 1.7) * 0.15;",
					"variable.blink_random_cooldown = math.random(3.0, 7.0);",
					"variable.blink_cooldown = ((variable.blink_cooldown ?? 0) <= 0) ? variable.blink_random_cooldown : variable.blink_cooldown;",
					"variable.blink_cooldown = math.max(0, variable.blink_cooldown - query.delta_time);",
					"variable.should_blink = variable.blink_cooldown <= 0;"
				],
				"animate": ["general", "look_at_target", "eye_dart", "blink_controller"]
			},
			"render_controllers": [
				"controller.render.scientist_01"
			],
			"spawn_egg": {
				"texture": "brr_scientist_01_egg",
				"texture_index": 0
			}
		}
	}
}